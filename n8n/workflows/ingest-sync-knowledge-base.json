      "id": "node-0019-list-files-in-drive-folder",
      "name": "List files in Drive folder",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        440,
        300
      ],
      "credentials": {
        "googleApi": {
          "id": "dR5sA8vN3jK6hY2b",
          "name": "Google Drive service account"
        }
      },
      "onError": "continueRegularOutput",
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Supported types only (PDF, DOCX, Google Docs, Markdown, plain text); other files in the folder are ignored\nconst listing = $input.first().json;\nif (listing.error || !Array.isArray(listing.files)) {\n  return [{ json: { ok: false, fatal_error: 'Could not list the Drive folder: ' + JSON.stringify(listing.error ?? listing).slice(0, 500) } }];\n}\nif (listing.nextPageToken) {\n  return [{ json: { ok: false, fatal_error: 'The folder has more than 1000 files; paging is not implemented.' } }];\n}\nconst files = listing.files.map(file => ({\n  source_id: file.id,\n  title: file.name.replace(/\\.(pdf|docx|md|txt)$/i, ''),\n  modified_at: file.modifiedTime,\n  mime_type: file.mimeType,\n  source_url: file.webViewLink,\n}));\nreturn [{ json: { ok: true, files } }];"
      },
