    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Counts per status; a failed file does not stop the others\nconst listing = $('Prepare file list').first().json;\nconst plan = $('Plan sync').isExecuted ? $('Plan sync').first().json.r : null;\nconst stats = { files_seen: listing.files?.length ?? 0, added: 0, updated: 0, unchanged: plan?.unchanged ?? 0,\n  deleted: 0, failed: 0, errors: [] };\nif (!listing.ok) stats.fatal_error = listing.fatal_error;\nelse if (plan && !plan.ok) stats.fatal_error = plan.message;\nfor (const { json } of $input.all()) {\n  if (json.action === 'none' || json.ok === false) continue;\n  if (json.status === 'added' || json.status === 'updated' || json.status === 'unchanged' || json.status === 'deleted') {\n    stats[json.status] += 1;\n  } else if (json.status !== 'already_deleted') {\n    stats.failed += 1;\n    stats.errors.push({ source_id: json.source_id ?? null, title: json.title ?? null, error: json.error ?? 'Unknown error' });\n  }\n}\nreturn [{ json: { run_id: $('Start ingestion run').first().json.r.run_id, stats } }];"
      },
