    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT knowledge.plan_sync($1, 'google_drive', $2::jsonb) AS r;",
        "options": {
          "queryReplacement": "={{ [$('Start').first().json.knowledge_base, JSON.stringify($json.files)] }}"
        }
      },
      "id": "node-0022-plan-sync",
      "name": "Plan sync",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "position": [
        1100,
        200
      ],
      "credentials": {
        "postgres": {
          "id": "pG7rT2kW9mQ4xL1z",
          "name": "Postgres rag_app"
        }
      }
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// One item per file to process or delete; a single 'none' item when there is nothing to do\nconst start = $('Start').first().json;\nconst plan = $input.first().json.r;\nif (!plan.ok) return [{ json: { action: 'none' } }];\nconst files = Object.fromEntries($('Prepare file list').first().json.files.map(file => [file.source_id, file]));\nconst base = { knowledge_base: start.knowledge_base, source: 'google_drive' };\nconst work = [\n  ...plan.to_process.map(file => ({ ...base, action: 'process', ...files[file.source_id] })),\n  ...plan.to_delete.map(document => ({ ...base, action: 'delete', source_id: document.source_id, title: document.title })),\n];\nreturn work.length ? work.map(json => ({ json })) : [{ json: { action: 'none' } }];"
      },
      "id": "node-0023-plan-work",
      "name": "Plan work",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
