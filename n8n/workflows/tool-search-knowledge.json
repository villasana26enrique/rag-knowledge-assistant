          "name": "Postgres rag_app"
        }
      },
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Compact passages with a ready-to-cite source: \"Aftercare Guide, Tooth Extraction > Eating and drinking, p. 1\"\nconst r = $input.first().json.r;\nif (!r.ok) return [{ json: { ok: false, answerable: false, message: r.message, passages: [] } }];\nconst passages = r.results.map(p => {\n  const section = p.section?.startsWith(p.document_title) ? p.section.slice(p.document_title.length).replace(/^ > /, '') : p.section;\n  const pages = p.page_start ? (p.page_start === p.page_end ? `p. ${p.page_start}` : `pp. ${p.page_start}-${p.page_end}`) : null;\n  return { source: [p.document_title, section, pages].filter(Boolean).join(', '), text: p.content,\n           url: p.source_url ?? null, similarity: p.similarity };\n});\nreturn [{ json: { ok: true, answerable: r.answerable, message: r.message, query_id: r.query_id, top_similarity: r.top_similarity, min_similarity: r.min_similarity, passages } }];"
      },
