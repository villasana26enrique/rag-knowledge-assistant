      "id": "node-0003-search-the-knowledge-base",
      "name": "Search the knowledge base",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "position": [
        440,
        300
      ],
      "credentials": {
        "postgres": {
