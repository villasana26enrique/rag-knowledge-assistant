      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const start = $('Start').first().json;\nconst document = $('Extract and chunk').first().json;\nconst embeddings = $input.all().flatMap(item => item.json.embeddings.map(embedding => embedding.values));\nif (embeddings.length !== document.chunks.length) {\n  throw new Error(`Got ${embeddings.length} embeddings for ${document.chunks.length} chunks`);\n}\nreturn [{ json: {\n  document: {\n    source: start.source, source_id: start.source_id, title: start.title, mime_type: start.mime_type,\n    source_url: start.source_url || null, content_hash: document.content_hash, source_modified_at: start.modified_at,\n  },\n  chunks: document.chunks.map((chunk, i) => ({\n    section: chunk.section, content: chunk.content, token_count: chunk.token_count,\n    page_start: chunk.page_start, page_end: chunk.page_end, embedding: embeddings[i],\n  })),\n} }];"
      },
