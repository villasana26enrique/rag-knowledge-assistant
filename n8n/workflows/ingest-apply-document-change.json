    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Gemini embeds up to 100 texts per request\nconst document = $('Extract and chunk').first().json;\nconst batches = [];\nfor (let i = 0; i < document.chunks.length; i += 100) {\n  batches.push({ json: { requests: document.chunks.slice(i, i + 100).map(chunk => ({\n    model: 'models/gemini-embedding-001',\n    content: { parts: [{ text: chunk.embedding_text }] },\n    taskType: 'RETRIEVAL_DOCUMENT',\n    title: document.title,\n    outputDimensionality: 768,\n  })) } });\n}\nreturn batches;"
      },
