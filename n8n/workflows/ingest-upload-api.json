        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const outcome = $input.first().json;\nconst ok = ['added', 'updated', 'unchanged'].includes(outcome.status);\nconst stats = { files_seen: 1, added: 0, updated: 0, unchanged: 0, deleted: 0, failed: ok ? 0 : 1,\n  errors: ok ? [] : [{ source_id: outcome.source_id ?? null, title: outcome.title ?? null, error: outcome.error ?? 'Unknown error' }] };\nif (ok) stats[outcome.status] = 1;\nreturn [{ json: { run_id: $('Start ingestion run').first().json.r.run_id, stats, outcome } }];"
      },
