# Copy this file to .env and fill in real values. Never commit .env.

# PostgreSQL (POSTGRES_USER owns the schema and runs the migrations)
POSTGRES_USER=rag_owner
POSTGRES_PASSWORD=change-me
POSTGRES_DB=rag
POSTGRES_HOST_PORT=5434
# Password of rag_app, the unprivileged role n8n connects with (row level security applies to it).
# Letters and digits only.
RAG_APP_PASSWORD=change-me-too

# n8n
N8N_VERSION=2.40.5
# Public base URL n8n should use for webhooks (with trailing slash)
N8N_WEBHOOK_URL=http://localhost:5679/
# Encrypts the credentials stored in n8n. Generate one (e.g. openssl rand -hex 24) and keep it safe:
# without it, saved credentials cannot be read.
N8N_ENCRYPTION_KEY=generate-a-long-random-string
N8N_HOST_PORT=5679

# Optional: reuse existing Docker volumes instead of creating new ones
# POSTGRES_VOLUME=rag_knowledge_assistant_postgres
# N8N_VOLUME=rag_knowledge_assistant_n8n
