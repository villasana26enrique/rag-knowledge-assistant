# Copy this file to .env and fill in real values. Never commit .env.

# PostgreSQL (POSTGRES_USER owns the schema and runs the migrations)
POSTGRES_USER=rag_owner
POSTGRES_PASSWORD=change-me
POSTGRES_DB=rag
POSTGRES_HOST_PORT=5434
# Password of rag_app, the unprivileged role n8n connects with (row level security applies to it).
# Letters and digits only.
RAG_APP_PASSWORD=change-me-too

# n8n
N8N_VERSION=2.40.5
# Public base URL n8n should use for webhooks (with trailing slash)
N8N_WEBHOOK_URL=http://localhost:5679/
# Encrypts the credentials stored in n8n. Generate one (e.g. openssl rand -hex 24) and keep it safe:
# without it, saved credentials cannot be read.
N8N_ENCRYPTION_KEY=generate-a-long-random-string
N8N_HOST_PORT=5679

# ---- Used by scripts/setup-n8n.sh to create the n8n credentials ----
# Google AI Studio API key (Gemini embeddings)
GEMINI_API_KEY=your-gemini-api-key
# Google Cloud service account JSON key with read access to the Drive folders (Drive API enabled).
# Path to the file, kept OUTSIDE the repository; the key itself never goes in .env.
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=/path/outside/the/repo/drive-service-account.json
# Drive folders synced into each knowledge base (the id at the end of the folder URL),
# shared with the service account's email as Viewer
DRIVE_FOLDER_PATIENT_HANDBOOK=your-patient-handbook-folder-id
DRIVE_FOLDER_STAFF_HANDBOOK=your-staff-handbook-folder-id
# Upload API: callers send it in the X-API-Key header (e.g. openssl rand -hex 24)
INGEST_API_KEY=generate-a-long-random-string

# Evaluations (evals/run_evals.py): search API keys of each agent,
# created with ./scripts/create-api-key.sh patient-assistant evals (and staff-assistant)
EVALS_PATIENT_API_KEY=your-patient-assistant-key
EVALS_STAFF_API_KEY=your-staff-assistant-key

# Optional: reuse existing Docker volumes instead of creating new ones
# POSTGRES_VOLUME=rag_knowledge_assistant_postgres
# N8N_VOLUME=rag_knowledge_assistant_n8n
